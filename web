            <polygon points="3 11 22 2 13 21 11 13 3 11"/>
          </svg>
          Cómo llegar en Google Maps
        </a>
      </div>

      <a href="https://maps.google.com/?q=Jr.+Jose+Galvez+272,+Santiago+de+Surco" target="_blank" rel="noopener noreferrer" class="map-card-link">
