        <div class="features-list">
          <div class="feature-item"><span>✓</span> Profesionales Calificados</div>
          <div class="feature-item"><span>✓</span> Tecnología Moderna</div>
          <div class="feature-item"><span>✓</span> Atención Personalizada</div>
          <div class="feature-item"><span>✓</span> Garantía en Tratamientos</div>
        </div>
      </div>
      <div class="about-image-box">
        Consultorio Dental J&G
      </div>
    </div>
  </section>

  <!-- 4. SECCIÓN INSTALACIONES -->
  <section id="instalaciones" class="section">
    <div class="container">
      <div class="section-header">
        <span class="gold-line" style="margin: 0 auto 15px;"></span>
        <h2>Nuestras Instalaciones</h2>
        <p>Espacios modernos, limpios y diseñados exclusivamente para tu comodidad y tranquilidad.</p>
      </div>

      <div class="facilities-grid">
        <div class="facility-card" style="background-color: #1a365d;">
          <span>Sala de Espera</span>
        </div>
        <div class="facility-card" style="background-color: #2a4365;">
          <span>Consultorio Principal</span>
        </div>
        <div class="facility-card" style="background-color: #2b6cb0;">
          <span>Área de Esterilización</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. SECCIÓN UBICACIÓN -->
  <section id="ubicacion" class="section section-alt">
    <div class="container location-grid">
      <div class="location-details">
        <span class="gold-line"></span>
        <h2>Ubicación</h2>
        <p class="section-desc">Estamos ubicados en una zona accesible de Surco Viejo, cerca de la Plaza de Armas.</p>

        <div class="info-list">
