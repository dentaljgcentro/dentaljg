      </div>
    </div>
    <div class="hero-image">
      <div class="hero-placeholder-img">Dental J&G Sonrisa</div>
    </div>
  </section>

  <!-- 2. SECCIÓN SERVICIOS -->
  <section id="servicios" class="section">
    <div class="container">
      <div class="section-header">
        <span class="gold-line" style="margin: 0 auto 15px;"></span>
        <h2>Nuestros Servicios</h2>
        <p>Soluciones odontológicas integrales adaptadas a cada necesidad para cuidar de tu salud bucal.</p>
      </div>

      <div class="services-grid">
        <div class="service-card">
