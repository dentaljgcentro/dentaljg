          <div class="info-item">
            <div class="info-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0B1E33" stroke-width="2">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
            </div>
            <div>
              <strong>Horario de Atención</strong>
              <p>Lunes a Sábado: 9:00 a.m. – 7:00 p.m.</p>
