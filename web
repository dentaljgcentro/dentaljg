  <!-- 3. SECCIÓN NOSOTROS -->
  <section id="nosotros" class="section section-alt">
    <div class="container about-grid">
      <div class="about-content">
        <span class="gold-line"></span>
        <h2>Comprometidos con tu salud y bienestar</h2>
